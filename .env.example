BOT_TOKEN=your_bot_token
GEMINI_API_KEY=your_gemini_api_key
ADMIN_USER_ID=123456789
# Несколько администраторов через запятую (необязательно)
ADMIN_USER_IDS=123456789
SOURCE_CHANNEL=@source_channel
TARGET_CHANNEL=@target_channel
# Несколько каналов назначения через запятую. Если не указано, используется TARGET_CHANNEL.
TARGET_CHANNELS=@target_channel_1,@target_channel_2
# Можно указать ID канала вместо username: -1001234567890
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_telegram_api_hash
# Файл сессии личного аккаунта; не публикуйте его
TELETHON_SESSION=data/userbot
# Для Render рекомендуется StringSession вместо файла. Получите её один раз локально.
TELETHON_SESSION_STRING=
GEMINI_MODEL=gemini-3.6-flash
DB_PATH=data/bot.sqlite3
TIMEZONE=Europe/Moscow
BLOCKED_KEYWORDS=
BLOCKED_LINK_DOMAINS=
REQUIRED_HASHTAGS=
BLOCKED_AUTHOR_IDS=
BLOCKED_EXTENSIONS=exe,bat,cmd,com,scr
TEST_MODE=0
LOG_PATH=data/bot.log
MAX_MEDIA_MB=50
WEB_HOST=0.0.0.0
WEB_PORT=8080
